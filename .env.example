# EPS Korean Trainer Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# Application Environment: 'production' or 'development'
APP_ENV=production
APP_NAME="EPS Korean Trainer"

# Application Base URL
# Set your full domain/subdirectory URL (e.g. https://yourdomain.com or https://yourdomain.com/eps-topik)
# If set to 'auto' or left empty, the application will auto-detect the domain and scheme.
APP_URL=auto

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eps_topik
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Voice / TTS Integration (Optional - default uses browser TTS)
# Options for provider: browser_tts | google_cloud | openai
TTS_DEFAULT_PROVIDER=browser_tts
TTS_GOOGLE_API_KEY=
TTS_OPENAI_API_KEY=

# Timezone
TIMEZONE=Asia/Manila
